CT_CONFIG_VERSION="4"
CT_ARCH_ARM=y
CT_ARCH_CPU="cortex-a8"
CT_ARCH_FPU="neon"
CT_ARCH_FLOAT_SOFTFP=y
CT_TARGET_VENDOR="cortex_a8"
CT_KERNEL_LINUX=y
CT_LINUX_V_2_6_32=y
CT_BINUTILS_LINKER_LD_GOLD=y
CT_BINUTILS_GOLD_THREADS=y
CT_BINUTILS_LD_WRAPPER=y
CT_BINUTILS_PLUGINS=y
CT_GLIBC_V_2_23=y
CT_GLIBC_EXTRA_CONFIG_ARRAY="MAKEINFO=:"
CT_GLIBC_EXTRA_CFLAGS=""
# CT_GLIBC_ENABLE_COMMON_FLAG is not set
CT_GCC_V_12=y
CT_CC_LANG_CXX=y
CT_DEBUG_DUMA=y
CT_DEBUG_GDB=y
# CT_GDB_CROSS_PYTHON is not set
CT_GDB_NATIVE=y
CT_DEBUG_LTRACE=y
CT_DEBUG_STRACE=y
